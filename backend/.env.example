# PostgreSQL. For a quick local smoke test you can use:
# DATABASE_URL=sqlite:///./fitos.db
DATABASE_URL=postgresql+psycopg://fitos:fitos@localhost:5432/fitos

# USDA FoodData Central. Never commit a real key.
USDA_API_KEY=

# Identify FitOS to Open Food Facts.
OPEN_FOOD_FACTS_USER_AGENT=FitOS/0.4 (contact: replace-with-your-email@example.com)

# Comma-separated origins. Add the deployed GitHub Pages URL.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://arvndayan.github.io

# Search/cache behavior
USDA_ENABLED=true
OPEN_FOOD_FACTS_ENABLED=true
CACHE_EXTERNAL_RESULTS=true
